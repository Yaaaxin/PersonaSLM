{
  "$id": "https://github.com/Yaaaxin/PersonaSLM/blob/main/docs/validation/literature_monitor_v1/ledger_schema_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automated_discovery_is_not_scientific_confirmation": {"const": true},
    "last_successful_primary_source_check": {"format": "date", "type": "string"},
    "project": {"const": "PersonaSLM"},
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authors": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
          "date_last_checked": {"format": "date", "type": "string"},
          "difference_from_personaslm": {"minLength": 1, "type": "string"},
          "identifiers": {"additionalProperties": {"type": "string"}, "minProperties": 1, "type": "object"},
          "overlap_with_personaslm": {"minLength": 1, "type": "string"},
          "potential_methodological_improvements": {"items": {"type": "string"}, "type": "array"},
          "potential_novelty_threat": {
            "additionalProperties": false,
            "properties": {
              "level": {"enum": ["LOW", "MODERATE", "HIGH", "UNKNOWN"]},
              "rationale": {"minLength": 1, "type": "string"}
            },
            "required": ["level", "rationale"],
            "type": "object"
          },
          "potential_useful_baselines": {"items": {"type": "string"}, "type": "array"},
          "publication_date": {"minLength": 4, "type": "string"},
          "relevance_assessment": {
            "additionalProperties": false,
            "properties": {
              "classification": {
                "enum": ["DIRECT_OVERLAP", "PARTIAL_OVERLAP", "COMPLEMENTARY", "BASELINE_RELEVANT", "EVALUATION_RELEVANT", "LOW_RELEVANCE"]
              },
              "rationale": {"minLength": 1, "type": "string"}
            },
            "required": ["classification", "rationale"],
            "type": "object"
          },
          "relevant_benchmarks": {"items": {"type": "string"}, "type": "array"},
          "relevant_experimental_factors": {"items": {"type": "string"}, "type": "array"},
          "research_methodology": {"minLength": 1, "type": "string"},
          "source_url": {"format": "uri", "type": "string"},
          "stable_id": {"minLength": 1, "type": "string"},
          "title": {"minLength": 1, "type": "string"},
          "venue_or_status": {"minLength": 1, "type": "string"},
          "verification": {
            "additionalProperties": false,
            "properties": {
              "evidence_scope": {"minLength": 1, "type": "string"},
              "human_confirmation": {"enum": ["NOT_RECORDED", "CONFIRMED"]},
              "primary_sources": {"items": {"format": "uri", "type": "string"}, "minItems": 1, "type": "array"},
              "reviewer_type": {"enum": ["AI_ASSISTED_PRIMARY_SOURCE_REVIEW", "HUMAN_PRIMARY_SOURCE_REVIEW"]},
              "verified_on": {"format": "date", "type": "string"}
            },
            "required": ["evidence_scope", "human_confirmation", "primary_sources", "reviewer_type", "verified_on"],
            "type": "object"
          },
          "verified_abstract_or_summary": {
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["PRIMARY_SOURCE_ABSTRACT_PARAPHRASE", "PRIMARY_SOURCE_METHODS_SUMMARY"]},
              "text": {"minLength": 1, "type": "string"}
            },
            "required": ["kind", "text"],
            "type": "object"
          },
          "versions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "label": {"minLength": 1, "type": "string"},
                "source_url": {"format": "uri", "type": "string"}
              },
              "required": ["label", "source_url"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "stable_id", "title", "authors", "venue_or_status", "publication_date", "identifiers", "source_url",
          "verified_abstract_or_summary", "research_methodology", "relevant_experimental_factors", "relevant_benchmarks",
          "overlap_with_personaslm", "difference_from_personaslm", "potential_novelty_threat", "potential_useful_baselines",
          "potential_methodological_improvements", "relevance_assessment", "versions", "verification", "date_last_checked"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {"const": "personaslm_reviewed_literature_ledger_v1"},
    "scope": {"minLength": 1, "type": "string"}
  },
  "required": ["schema_version", "project", "scope", "automated_discovery_is_not_scientific_confirmation", "last_successful_primary_source_check", "records"],
  "title": "PersonaSLM reviewed literature ledger",
  "type": "object"
}
